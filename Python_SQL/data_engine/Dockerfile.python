FROM python:3.11-slim

# Install system dependencies for SQLite
RUN apt-get update && apt-get install -y sqlite3 && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy requirements and install
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy the rest of the engine code
COPY . .

# Environment variables (Defaults that docker-compose will override)
ENV EXCEL_SOURCE="/onedrive/Injection diary.xlsx"
ENV DB_DESTINATION="/app/data/injection_diary.db"

# By default, run the update script
CMD ["python", "scripts/update_DB.py"]